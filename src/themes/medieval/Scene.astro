---
import profile from '../../data/profile.json';
import type { ThemeCopy } from '../../data/theme-copy';
import content from './copy.json';
const copy: typeof content & ThemeCopy = content;
import ThemeSwitcher from '../../components/ThemeSwitcher.astro';
import './theme.css';
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path}`;
---

<article
  data-scene="medieval"
  class="folio"
  aria-label={copy.world.title}
  data-world-name={copy.world.name}
  data-world-title={copy.world.title}
  data-world-transition={copy.world.transition}
>
  <div class="folio-frame">
    <header class="folio-header">
      <a
        class="folio-monogram"
        href="#medieval-home"
        aria-label={`${profile.name}, home`}
      >
        {profile.name[0].toLowerCase()}
        <span aria-hidden="true">.</span>
      </a>
      <span class="folio-edition">
        {copy.header.edition} <span aria-hidden="true">·</span>{' '}
        {copy.header.since} {profile.careerStart}
      </span>
      <ThemeSwitcher theme="medieval" copy={copy.controls} />
    </header>
    <main id="medieval-home">
      <section class="folio-hero" aria-labelledby="medieval-name">
        <div class="folio-intro">
          <div class="folio-eyebrow" data-reveal>
            <span aria-hidden="true">✦</span> {copy.hero.eyebrow}
          </div>
          <h1 id="medieval-name" data-reveal>
            {profile.name}
            <span class="folio-period">.</span>
          </h1>
          <p class="folio-role" data-reveal>
            {profile.role}
          </p>
          <p class="folio-lede" data-reveal>
            {copy.hero.intro}
          </p>
          <div class="folio-actions" data-reveal>
            <a
              class="ink-button"
              href={`mailto:${profile.email}`}
              aria-label={`${copy.actions.contact} — get in touch`}
            >
              {copy.actions.contact} <span aria-hidden="true">↗</span>
            </a>
            <a class="folio-resume" href={asset(profile.resume)}>
              {copy.actions.resume} <span aria-hidden="true">↓</span>
            </a>
          </div>
          <div class="folio-location" data-reveal>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 17s6-6 6-10A6 6 0 0 0 4 7c0 4 6 10 6 10Z" />
              <circle cx="10" cy="7" r="2" />
            </svg>
            {copy.hero.locationPrefix} {profile.location}{' '}
            <span class="location-flourish" aria-hidden="true">
              —
            </span>
          </div>
        </div>
        <figure class="folio-art" aria-label={copy.art.label}>
          <div
            class="folio-art-orbit"
            data-ambient="orbit"
            aria-hidden="true"
          ></div>
          <img
            src={asset('themes/medieval/island.svg')}
            width="680"
            height="640"
            alt={copy.art.alt}
            fetchpriority="high"
          />
          <span class="folio-art-star" data-ambient="star" aria-hidden="true">
            ✧
          </span>
          <figcaption>
            <span>{copy.art.figure}</span> {copy.art.caption}
          </figcaption>
        </figure>
        <span class="folio-side-note" aria-hidden="true">
          {copy.hero.margin}
        </span>
      </section>
      <section class="folio-practice" aria-label="Capabilities and experience">
        <div class="folio-craft">
          <p class="folio-section-label">{copy.about.label}</p>
          <h2>
            {copy.about.heading.lead}
            <br />
            <em>{copy.about.heading.accent}</em>
          </h2>
          <p>{copy.about.body}</p>
          <ul>
            {profile.capabilities.map((capability) => (
              <li>{copy.capabilities[capability.id]}</li>
            ))}
          </ul>
          <p class="folio-tool-note">
            {copy.about.toolsLabel} {profile.tools.join(' · ')}
          </p>
        </div>
        <div class="folio-experience">
          <p class="folio-section-label">{copy.experienceHeading}</p>
          {profile.experience.map((job) => (
            <div class="folio-job">
              <span class="folio-job-mark" aria-hidden="true">
                ✧
              </span>
              <div>
                <h3>{job.company}</h3>
                <p>{job.role}</p>
                <p class="folio-job-summary">
                  {copy.experience[job.id].summary}
                </p>
              </div>
              <span class="folio-job-period">{job.period}</span>
            </div>
          ))}
        </div>
      </section>
      <section class="folio-work" aria-labelledby="medieval-work">
        <div class="folio-work-heading">
          <div>
            <p class="folio-section-label">{copy.work.kicker}</p>
            <h2 id="medieval-work">
              {copy.work.heading.lead} <em>{copy.work.heading.accent}</em>
            </h2>
          </div>
          <span class="folio-volume" aria-hidden="true">
            {copy.work.volume}
          </span>
        </div>
        <div class="folio-projects">
          {profile.projects
            .filter((project) => project.featured)
            .map((project, index) => (
              <article class="folio-project">
                <a
                  href={project.url}
                  class="folio-project-image"
                  aria-label={`${copy.actions.explore} — ${project.name}`}
                >
                  <span class="folio-plate">
                    {copy.work.plate} {index === 0 ? 'I' : 'II'}
                  </span>
                  <img
                    src={asset(project.image!)}
                    alt={`${project.name} website preview`}
                    width="800"
                    height="450"
                    loading="lazy"
                  />
                  <span class="folio-image-action" aria-hidden="true">
                    {copy.actions.explore} ↗
                  </span>
                </a>
                <div class="folio-project-title">
                  <h3>
                    <a href={project.url}>{project.name}</a>
                  </h3>
                  <span>{copy.projects[project.id].category}</span>
                </div>
                <p>{copy.projects[project.id].description}</p>
                <div class="folio-project-meta">
                  <span>{project.stack}</span>
                  <a
                    href={project.source}
                    aria-label={`${copy.actions.source} — ${project.name} source code`}
                  >
                    {copy.actions.source} <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))}
        </div>
        <div class="folio-experiments">
          <span class="folio-experiments-label">
            {copy.work.experiments} <span aria-hidden="true">↳</span>
          </span>
          {profile.projects
            .filter((project) => !project.featured)
            .map((project) => (
              <a href={project.url}>
                <span>
                  {project.name} <span aria-hidden="true">↗</span>
                </span>
                <small>{copy.projects[project.id].description}</small>
              </a>
            ))}
        </div>
      </section>
    </main>
    <footer class="folio-footer">
      <p>
        {copy.footer.lead} <span aria-hidden="true">✦</span>{' '}
        {copy.footer.accent}
      </p>
      <nav aria-label="Social links">
        {profile.socials.map((social) => (
          <a href={social.url}>{social.name} ↗</a>
        ))}
        <a
          href={`mailto:${profile.email}`}
          aria-label={`${copy.actions.email} — email`}
        >
          {copy.actions.email} ↗
        </a>
      </nav>
      <a
        href="#medieval-home"
        aria-label={`${copy.actions.backToTop} — back to top`}
      >
        {copy.actions.backToTop} ↑
      </a>
    </footer>
  </div>
</article>
