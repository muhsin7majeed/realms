---
import profile from '../../data/profile.json';
import type { ThemeCopy } from '../../data/theme-copy';
import content from './copy.json';
const copy: typeof content & ThemeCopy = content;
import ThemeSwitcher from '../../components/ThemeSwitcher.astro';
import './theme.css';
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path}`;
---

<article
  data-scene="cyberpunk"
  class="signal"
  aria-label={copy.world.title}
  data-world-name={copy.world.name}
  data-world-title={copy.world.title}
  data-world-transition={copy.world.transition}
>
  <div class="signal-shell">
    <header class="signal-header">
      <a
        href="#cyberpunk-home"
        class="signal-logo"
        aria-label={`${profile.name}, home`}
      >
        <span aria-hidden="true">[</span> {profile.fullName.split(' ')[0][0]}
        <span class="signal-logo-slash">/</span>
        {profile.fullName.split(' ').at(-1)![0]}{' '}
        <span aria-hidden="true">]</span>
      </a>
      <span class="signal-header-id">
        {copy.header.name}
        <span>{copy.header.identifier}</span>
      </span>
      <ThemeSwitcher theme="cyberpunk" copy={copy.controls} />
    </header>
    <main id="cyberpunk-home">
      <section class="signal-hero" aria-labelledby="cyberpunk-name">
        <div class="signal-hero-rail">
          <span>
            <i aria-hidden="true"></i> {profile.location}
          </span>
          <span>{copy.hero.rail}</span>
          <span aria-hidden="true">{copy.hero.identity}</span>
        </div>
        <div class="signal-intro">
          <p class="signal-eyebrow" data-reveal>
            <span aria-hidden="true">//</span> {profile.role}
          </p>
          <h1 id="cyberpunk-name" data-reveal>
            {profile.name}
            <span class="signal-name-mark" aria-hidden="true">
              _
            </span>
          </h1>
          <p class="signal-manifesto" data-reveal>
            {copy.hero.manifesto.lead}
            <br />
            <span>{copy.hero.manifesto.accent}</span>
          </p>
          <p class="signal-lede" data-reveal>
            {copy.hero.intro}
          </p>
          <div class="signal-actions" data-reveal>
            <a
              class="signal-button"
              href={`mailto:${profile.email}`}
              aria-label={`${copy.actions.contact} — get in touch`}
            >
              <span>{copy.actions.contact}</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a class="signal-resume" href={asset(profile.resume)}>
              {copy.actions.resume} <span aria-hidden="true">↓</span>
            </a>
          </div>
          <div class="signal-tools" data-reveal>
            <span>{copy.hero.toolsLabel}</span>
            {profile.tools.map((tool) => (
              <span>{tool}</span>
            ))}
          </div>
        </div>
        <figure class="signal-art" aria-label={copy.art.label}>
          <div class="signal-art-grid" aria-hidden="true"></div>
          <img
            data-lazy-src={asset('themes/cyberpunk/city.svg')}
            width="720"
            height="760"
            alt={copy.art.alt}
          />
          <div
            class="signal-ring signal-ring-one"
            data-ambient="ring"
            aria-hidden="true"
          ></div>
          <div class="signal-scan" data-ambient="scan" aria-hidden="true"></div>
          <span class="signal-art-tag">
            {copy.art.tag.lead}
            <br />
            {copy.art.tag.accent}
          </span>
          <figcaption>
            <span>
              <i aria-hidden="true"></i> {copy.art.caption}
            </span>
            <span aria-hidden="true">{copy.art.coordinates}</span>
          </figcaption>
        </figure>
        <div class="signal-hero-index" aria-hidden="true">
          <span>{copy.hero.scroll}</span>
          <span>↓</span>
          <span>{copy.hero.index}</span>
        </div>
      </section>
      <section class="signal-record" aria-label="Capabilities and experience">
        <div class="signal-record-label">
          <span>{copy.about.label}</span>
          <h2>
            {copy.about.heading.lead}
            <br />
            <span>{copy.about.heading.accent}</span>
          </h2>
        </div>
        <div class="signal-capabilities">
          <p>{copy.about.body}</p>
          <ul>
            {profile.capabilities.map((capability, index) => (
              <li>
                <span>0{index + 1}</span>
                {copy.capabilities[capability.id]}
                <span aria-hidden="true">↗</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="signal-experience">
          <p class="signal-section-label">{copy.experienceHeading}</p>
          {profile.experience.map((job) => (
            <div class="signal-job">
              <span>{job.period}</span>
              <h3>{job.company}</h3>
              <p class="signal-job-role">{job.role}</p>
              <p>{copy.experience[job.id].summary}</p>
            </div>
          ))}
        </div>
      </section>
      <section class="signal-work" aria-labelledby="cyberpunk-work">
        <div class="signal-work-heading">
          <span class="signal-section-label">{copy.work.kicker}</span>
          <h2 id="cyberpunk-work">
            {copy.work.heading.lead}
            <span>{copy.work.heading.accent}</span>
          </h2>
          <span class="signal-work-count" aria-hidden="true">
            [ {String(profile.projects.length).padStart(2, '0')}{' '}
            {copy.work.countLabel} ]
          </span>
        </div>
        <div class="signal-projects">
          {profile.projects
            .filter((project) => project.featured)
            .map((project, index) => (
              <article
                class:list={['signal-project', `signal-project-${project.id}`]}
              >
                <div class="signal-project-top">
                  <span>
                    0{index + 1} / {copy.projects[project.id].category}
                  </span>
                  <span aria-hidden="true">↗</span>
                </div>
                <a
                  class="signal-project-image"
                  href={project.url}
                  aria-label={`${copy.actions.explore} — ${project.name}`}
                >
                  <img
                    data-lazy-src={asset(project.image!)}
                    alt={`${project.name} website preview`}
                    width="800"
                    height="450"
                    loading="lazy"
                  />
                  <span class="signal-image-action" aria-hidden="true">
                    {copy.actions.explore} ↗
                  </span>
                </a>
                <div class="signal-project-body">
                  <h3>
                    <a href={project.url}>{project.name}</a>
                  </h3>
                  <p>{copy.projects[project.id].description}</p>
                  <div class="signal-project-meta">
                    <span>{project.stack}</span>
                    <a
                      href={project.source}
                      aria-label={`${copy.actions.source} — ${project.name} source code`}
                    >
                      {copy.actions.source} ↗
                    </a>
                  </div>
                </div>
              </article>
            ))}
        </div>
        <div class="signal-experiments">
          <span>
            {copy.work.experiments} <span aria-hidden="true">↘</span>
          </span>
          {profile.projects
            .filter((project) => !project.featured)
            .map((project, index) => (
              <a href={project.url}>
                <span class="signal-experiment-number">0{index + 3}</span>
                <span>
                  {project.name}
                  <small>{copy.projects[project.id].description}</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
        </div>
      </section>
    </main>
    <footer class="signal-footer">
      <span>
        {copy.footer.transmission}
        <span class="signal-footer-block" aria-hidden="true">
          ■
        </span>
      </span>
      <nav aria-label="Social links">
        {profile.socials.map((social) => (
          <a href={social.url}>{social.name} ↗</a>
        ))}
        <a
          href={`mailto:${profile.email}`}
          aria-label={`${copy.actions.email} — email`}
        >
          {copy.actions.email} ↗
        </a>
      </nav>
      <a
        href="#cyberpunk-home"
        aria-label={`${copy.actions.backToTop} — back to top`}
      >
        {copy.actions.backToTop} ↑
      </a>
    </footer>
  </div>
</article>
