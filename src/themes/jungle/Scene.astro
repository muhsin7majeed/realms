---
import profile from '../../data/profile.json';
import ThemeSwitcher from '../../components/ThemeSwitcher.astro';
import defs from './art/defs.svg?raw';
import mid from './art/mid.html?raw';
import fore from './art/fore.html?raw';
import sprigA from './art/sprig-a.svg?raw';
import sprigB from './art/sprig-b.svg?raw';
import sprigC from './art/sprig-c.svg?raw';
import sprigD from './art/sprig-d.svg?raw';
import './theme.css';
const asset = (path: string) => `${import.meta.env.BASE_URL}${path}`;
// Sprigs swing around their stem; the generator records it as data-anchor.
const pivot = (svg: string) => {
  const [x, y] = svg.match(/data-anchor="([^"]+)"/)![1].split(' ');
  return `transform-origin:${x}% ${y}%`;
};
// Fireflies drift inside the light shafts. Deterministic spread, no runtime randomness.
const motes = Array.from({ length: 14 }, (_, index) => ({
  left: 28 + ((index * 37) % 46),
  top: 10 + ((index * 53) % 62),
  size: 3 + (index % 3),
}));
---

<article
  class="jungle"
  data-scene="jungle"
  aria-label="The Understory"
  data-world-name="Jungle"
  data-world-title="The Understory"
  data-world-transition="Down into the understory."
>
  <Fragment set:html={defs} />
  <div class="jg-stage jg-stage-back" aria-hidden="true">
    <div class="jg-layer jg-layer-canopy" data-depth="0.05">
      <div class="jg-layer-inner" data-reveal>
        <img
          data-lazy-src={asset('themes/jungle/canopy.svg')}
          width="1600"
          height="1000"
          alt=""
        />
      </div>
    </div>
    <div class="jg-layer jg-layer-light" data-depth="0.1">
      <div class="jg-layer-inner" data-reveal>
        <i class="jg-glow"></i>
        <i class="jg-ray jg-ray-a" data-ambient="ray"></i>
        <i class="jg-ray jg-ray-b" data-ambient="ray"></i>
        <i class="jg-ray jg-ray-c" data-ambient="ray"></i>
        <i class="jg-mist jg-mist-a" data-ambient="mist"></i>
        <i class="jg-mist jg-mist-b" data-ambient="mist"></i>
        {motes.map((mote) => (
          <i
            class="jg-mote"
            data-ambient="mote"
            style={`left:${mote.left}%;top:${mote.top}%;width:${mote.size}px;height:${mote.size}px`}
          />
        ))}
      </div>
    </div>
    <div class="jg-layer jg-layer-mid" data-depth="0.18">
      <div class="jg-layer-inner" data-reveal>
        <Fragment set:html={mid} />
      </div>
    </div>
  </div>
  <header class="site-header">
    <a
      class="wordmark"
      href="#jungle-home"
      aria-label={`${profile.name}, home`}
    >
      <svg
        class="wordmark-leaf"
        viewBox="0 0 32 32"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M4 28C4 14 14 4 28 4c0 14-10 24-24 24Z"
          fill="url(#jg-g-bright)"
        ></path>
        <path
          d="M6 26 24 8"
          stroke="#0b1f11"
          stroke-width="1.4"
          fill="none"
        ></path>
      </svg>
      <span>
        {profile.fullName}
        <small>Personal portfolio</small>
      </span>
    </a>
    <ThemeSwitcher theme="jungle" />
  </header>
  <main id="jungle-home">
    <section class="glade-hero" aria-labelledby="jungle-name">
      <span
        class="jg-sprig jg-sprig-a"
        aria-hidden="true"
        data-ambient="sway"
        style={pivot(sprigA)}
      >
        <Fragment set:html={sprigA} />
      </span>
      <div class="hero-topline">
        <p class="eyebrow">
          <span class="leaf-dot" aria-hidden="true"></span>
          The Understory
        </p>
      </div>
      <div class="intro">
        <p class="hero-role" data-reveal>
          {profile.role}
        </p>
        <h1 id="jungle-name" data-reveal>
          {profile.name}
        </h1>
        <div class="hero-baseline" data-reveal>
          <span>{profile.location}</span>
          <span aria-hidden="true">·</span>
          <span>Growing since {profile.careerStart}</span>
        </div>
        <h2 class="hero-statement" data-reveal>
          Grown slowly.
          <br />
          Built to last.
        </h2>
        <p class="intro-copy" data-reveal>
          {profile.intro}
        </p>
        <div class="hero-actions" data-reveal>
          <a class="leaf-button" href={`mailto:${profile.email}`}>
            Get in touch
            <span aria-hidden="true">→</span>
          </a>
          <a class="resume-link" href={asset(profile.resume)}>
            The résumé
            <span aria-hidden="true">↓</span>
          </a>
        </div>
        <nav class="hero-socials" aria-label="Social links" data-reveal>
          {profile.socials.map((social) => (
            <a href={social.url}>{social.name} ↗</a>
          ))}
        </nav>
      </div>
      <div class="hero-bottom">
        <span class="eyebrow tools">
          {profile.tools.map((tool, index) => (
            <>
              {index > 0 && <span aria-hidden="true">/</span>}
              {tool}
            </>
          ))}
        </span>
        <p class="art-caption">Every leaf here is drawn in code. Brush one.</p>
      </div>
    </section>
    <section class="roots" aria-labelledby="jungle-roots">
      <span
        class="jg-sprig jg-sprig-c"
        aria-hidden="true"
        data-ambient="sway"
        style={pivot(sprigC)}
      >
        <Fragment set:html={sprigC} />
      </span>
      <div class="roots-panel">
        <div class="section-heading">
          <span class="eyebrow">01 / Roots</span>
          <span class="eyebrow section-note" aria-hidden="true">
            What holds it up
          </span>
        </div>
        <div class="roots-grid">
          <div class="capabilities">
            <h2 id="jungle-roots">
              Things that
              <br />
              <em>hold.</em>
            </h2>
            <p>{profile.about}</p>
            <ul>
              {profile.capabilities.map((capability) => (
                <li>
                  <span class="leaf-mark" aria-hidden="true"></span>
                  {capability}
                </li>
              ))}
            </ul>
          </div>
          <div class="experience">
            <h3 class="eyebrow">Growth rings</h3>
            {profile.experience.map((job) => (
              <article class="job">
                <p class="job-period">{job.period}</p>
                <h4>{job.company}</h4>
                <p class="job-role">{job.role}</p>
                <p>{job.summary}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
    <section class="grove" aria-labelledby="jungle-grove">
      <span
        class="jg-sprig jg-sprig-d"
        aria-hidden="true"
        data-ambient="sway"
        style={pivot(sprigD)}
      >
        <Fragment set:html={sprigD} />
      </span>
      <div class="section-heading grove-heading">
        <div>
          <span class="eyebrow">02 / What grew here</span>
          <h2 id="jungle-grove">
            Work that <em>took root.</em>
          </h2>
        </div>
        <span class="eyebrow section-note" aria-hidden="true">
          {String(profile.projects.length).padStart(2, '0')} specimens
        </span>
      </div>
      {profile.projects
        .filter((project) => project.featured)
        .map((project, index) => (
          <article class="grove-project">
            <div class="project-frame">
              <a
                class="project-image"
                href={project.url}
                aria-label={`Explore ${project.name}`}
              >
                <img
                  data-lazy-src={asset(project.image!)}
                  width="800"
                  height="450"
                  alt={`${project.name} website preview`}
                  loading="lazy"
                />
              </a>
              <span
                class="jg-sprig jg-sprig-b"
                aria-hidden="true"
                data-ambient="sway"
                style={pivot(sprigB)}
              >
                <Fragment set:html={sprigB} />
              </span>
            </div>
            <div class="project-copy">
              <p class="eyebrow">
                0{index + 1} / {project.category}
              </p>
              <h3>
                <a href={project.url}>{project.name}</a>
              </h3>
              <p>{project.description}</p>
              <p class="stack">{project.stack}</p>
              <div class="project-links">
                <a href={project.url}>
                  Explore the work
                  <span aria-hidden="true">→</span>
                </a>
                <a
                  href={project.source}
                  aria-label={`${project.name} source code`}
                >
                  Source
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      <div class="seedlings">
        <p class="eyebrow">Seedlings</p>
        {profile.projects
          .filter((project) => !project.featured)
          .map((project) => (
            <a href={project.url}>
              <span class="leaf-mark" aria-hidden="true" />
              <span>
                {project.name}
                <small>{project.description}</small>
              </span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div>
      <span class="eyebrow">
        There is always more light past the next leaf.
      </span>
      <a class="footer-contact" href={`mailto:${profile.email}`}>
        Email
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <nav aria-label="Footer links">
      <a href="https://github.com/muhsin7majeed/realms">Fork this ↗</a>
      <a href="#jungle-home">Back to the top ↑</a>
    </nav>
  </footer>
  <div class="jg-stage jg-stage-front" aria-hidden="true">
    <div class="jg-layer jg-layer-fore" data-depth="0.4">
      <div class="jg-layer-inner" data-reveal>
        <Fragment set:html={fore} />
      </div>
    </div>
  </div>
</article>
