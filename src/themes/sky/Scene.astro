---
import profile from '../../data/profile.json';
import ThemeSwitcher from '../../components/ThemeSwitcher.astro';
import defs from './art/defs.svg?raw';
import clouds from './art/clouds.html?raw';
import heroCloud from './art/hero-cloud.svg?raw';
import balloon from './art/balloon.svg?raw';
import kite from './art/kite.svg?raw';
import './theme.css';
const asset = (path: string) => `${import.meta.env.BASE_URL}${path}`;
const birds = Array.from({ length: 9 });
---

<article
  class="sky"
  data-scene="sky"
  aria-label="Above the Clouds"
  data-world-name="Sky"
  data-world-title="Above the Clouds"
  data-world-transition="Climbing out of the haze."
>
  <Fragment set:html={defs} />
  <div class="sk-stage sk-stage-back" aria-hidden="true">
    <div class="sk-layer sk-light" data-reveal>
      <canvas class="sk-canvas" width="2" height="2"></canvas>
      <i class="sk-fallback"></i>
    </div>
    <div class="sk-layer sk-mid" data-reveal>
      <span class="sk-balloon sk-balloon-a" data-ambient="balloon">
        <Fragment set:html={balloon} />
      </span>
      <span class="sk-balloon sk-balloon-b" data-ambient="balloon">
        <Fragment set:html={balloon} />
      </span>
      <svg
        class="sk-contrail-art"
        viewBox="0 0 1600 300"
        preserveAspectRatio="none"
      >
        <path
          data-ambient="contrail"
          d="M-40 190C300 120 700 210 1060 110s420-40 620-70"
          fill="none"
          stroke="#fff"
          stroke-width="2.2"
          stroke-linecap="round"
          opacity="0"
        ></path>
      </svg>
    </div>
  </div>
  <header class="site-header">
    <a class="wordmark" href="#sky-home" aria-label={`${profile.name}, home`}>
      <svg
        class="wordmark-sun"
        viewBox="0 0 32 32"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="16" cy="18" r="7" fill="#ffb547"></circle>
        <path
          d="M4 24c3-3 7-3 10 0s7 3 10 0 5-2 8 0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
      </svg>
      <span>
        {profile.fullName}
        <small>Personal portfolio</small>
      </span>
    </a>
    <ThemeSwitcher theme="sky" />
  </header>
  <main id="sky-home">
    <section class="ascent-hero" aria-labelledby="sky-name">
      <div class="hero-topline">
        <p class="eyebrow">
          <span class="sun-dot" aria-hidden="true"></span>
          Above the clouds
        </p>
        <span class="eyebrow altitude" aria-hidden="true">
          Altitude <span data-altitude>0 m</span>
        </span>
      </div>
      <div class="intro">
        <p class="hero-role" data-reveal>
          {profile.role}
        </p>
        <h1 id="sky-name" data-reveal>
          {profile.name}
        </h1>
        <div class="hero-baseline" data-reveal>
          <span>{profile.location}</span>
          <span aria-hidden="true">—</span>
          <span>Airborne since {profile.careerStart}</span>
        </div>
        <h2 class="hero-statement" data-reveal>
          Higher ground.
          <br />
          Clearer air.
        </h2>
        <p class="intro-copy" data-reveal>
          {profile.intro}
        </p>
        <div class="hero-actions" data-reveal>
          <a class="sky-button" href={`mailto:${profile.email}`} data-magnet>
            Get in touch
            <span aria-hidden="true">→</span>
          </a>
          <a class="resume-link" href={asset(profile.resume)} data-magnet>
            The résumé
            <span aria-hidden="true">↓</span>
          </a>
        </div>
        <nav class="hero-socials" aria-label="Social links" data-reveal>
          {profile.socials.map((social) => (
            <a href={social.url}>{social.name} ↗</a>
          ))}
        </nav>
      </div>
      <div class="hero-bottom">
        <span class="eyebrow tools">
          {profile.tools.map((tool, index) => (
            <>
              {index > 0 && <span aria-hidden="true">/</span>}
              {tool}
            </>
          ))}
        </span>
        <p class="art-caption">
          Move the cursor. It’s the wind. Scroll to climb.
        </p>
      </div>
    </section>
    <section class="deck" aria-labelledby="sky-deck">
      <div class="sk-panel" data-tilt>
        <div class="section-heading">
          <span class="eyebrow">01 / Lift</span>
          <span class="eyebrow section-note" aria-hidden="true">
            What keeps it up
          </span>
        </div>
        <div class="deck-grid">
          <div class="capabilities">
            <h2 id="sky-deck">
              Built to
              <br />
              <em>stay up.</em>
            </h2>
            <p>{profile.about}</p>
            <ul>
              {profile.capabilities.map((capability) => (
                <li>
                  <span class="sun-dot" aria-hidden="true"></span>
                  {capability}
                </li>
              ))}
            </ul>
          </div>
          <div class="experience">
            <h3 class="eyebrow">Flight log</h3>
            {profile.experience.map((job) => (
              <article class="job">
                <p class="job-period">{job.period}</p>
                <h4>{job.company}</h4>
                <p class="job-role">{job.role}</p>
                <p>{job.summary}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
    <section class="clear-air" aria-labelledby="sky-work">
      <div class="section-heading clear-heading">
        <div>
          <span class="eyebrow">02 / Clear air</span>
          <h2 id="sky-work">
            Things that <em>took flight.</em>
          </h2>
        </div>
        <span class="eyebrow section-note" aria-hidden="true">
          {String(profile.projects.length).padStart(2, '0')} flights
        </span>
      </div>
      {profile.projects
        .filter((project) => project.featured)
        .map((project, index) => (
          <article class="flight sk-panel" data-tilt>
            <a
              class="project-image"
              href={project.url}
              aria-label={`Explore ${project.name}`}
            >
              <img
                data-lazy-src={asset(project.image!)}
                width="800"
                height="450"
                alt={`${project.name} website preview`}
                loading="lazy"
              />
            </a>
            <div class="flight-copy">
              <p class="eyebrow">
                0{index + 1} / {project.category}
              </p>
              <h3>
                <a href={project.url}>{project.name}</a>
              </h3>
              <p>{project.description}</p>
              <p class="stack">{project.stack}</p>
              <div class="project-links">
                <a href={project.url}>
                  Explore the work
                  <span aria-hidden="true">→</span>
                </a>
                <a
                  href={project.source}
                  aria-label={`${project.name} source code`}
                >
                  Source
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      <div class="short-hops">
        <p class="eyebrow">Short hops</p>
        {profile.projects
          .filter((project) => !project.featured)
          .map((project) => (
            <a href={project.url}>
              <span class="sun-dot" aria-hidden="true" />
              <span>
                {project.name}
                <small>{project.description}</small>
              </span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div>
      <span class="eyebrow">Land whenever you like.</span>
      <a class="footer-contact" href={`mailto:${profile.email}`}>
        Email
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <nav aria-label="Footer links">
      <a href="https://github.com/muhsin7majeed/realms">Fork this ↗</a>
      <a href="#sky-home">Back to the top ↑</a>
    </nav>
  </footer>
  <div class="sk-stage sk-stage-front" aria-hidden="true">
    <div class="sk-layer sk-front" data-reveal>
      <Fragment set:html={clouds} />
      <div class="sk-drift" data-ambient="traverse">
        <div class="sk-cloud sk-hero-cloud" data-depth="2.2">
          <Fragment set:html={heroCloud} />
        </div>
      </div>
      <div class="sk-kite">
        <Fragment set:html={kite} />
      </div>
      <div class="sk-flock">
        {birds.map(() => (
          <i class="sk-bird">
            <svg viewBox="0 0 32 14" focusable="false">
              <path
                d="M1 9C6 2 11 3 16 9c5-6 10-7 15 0"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
              />
            </svg>
          </i>
        ))}
      </div>
      <i class="sk-flash"></i>
    </div>
  </div>
</article>
