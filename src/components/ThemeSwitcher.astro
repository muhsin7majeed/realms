---
import type { ThemeCopy } from '../data/theme-copy';
interface Props {
  theme: 'medieval' | 'cyberpunk' | 'metro';
  copy: ThemeCopy['controls'];
}
const { theme, copy } = Astro.props;
---

<div class:list={['world-controls', `${theme}-controls`]}>
  <fieldset class="world-picker" aria-label="Choose a visual world">
    <legend>{copy.legend}</legend>
    <button
      type="button"
      data-theme-choice="medieval"
      aria-pressed={theme === 'medieval'}
    >
      <span aria-hidden="true">✦</span> Medieval
    </button>
    <button
      type="button"
      data-theme-choice="cyberpunk"
      aria-pressed={theme === 'cyberpunk'}
    >
      <span aria-hidden="true">⌁</span> Cyberpunk
    </button>
    <button
      type="button"
      data-theme-choice="metro"
      aria-pressed={theme === 'metro'}
    >
      <span aria-hidden="true">▰</span> Metro
    </button>
  </fieldset>
  <button
    type="button"
    class="motion-toggle"
    data-motion-toggle
    aria-label={`${copy.motion.running} — pause ambient motion`}
    data-motion-running={copy.motion.running}
    data-motion-paused={copy.motion.paused}
    aria-pressed="false"
  >
    <span aria-hidden="true">Ⅱ</span>
    <span class="motion-label">{copy.motion.running}</span>
  </button>
</div>
