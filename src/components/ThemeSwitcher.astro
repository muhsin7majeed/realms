---
interface Props {
  theme: 'medieval' | 'cyberpunk';
}
const { theme } = Astro.props;
---

<div class:list={['world-controls', `${theme}-controls`]}>
  <fieldset class="world-picker" aria-label="Choose a visual world">
    <legend>
      {theme === 'medieval' ? 'Turn the page' : 'Switch frequency'}
    </legend>
    <button
      type="button"
      data-theme-choice="medieval"
      aria-pressed={theme === 'medieval'}
    >
      <span aria-hidden="true">✦</span> Medieval
    </button>
    <button
      type="button"
      data-theme-choice="cyberpunk"
      aria-pressed={theme === 'cyberpunk'}
    >
      <span aria-hidden="true">⌁</span> Cyberpunk
    </button>
  </fieldset>
  <button
    type="button"
    class="motion-toggle"
    data-motion-toggle
    aria-label="Pause ambient motion"
    aria-pressed="false"
  >
    <span aria-hidden="true">Ⅱ</span>
    <span class="motion-label">Motion on</span>
  </button>
</div>
