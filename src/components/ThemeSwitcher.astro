---
interface Props {
  theme: 'medieval' | 'cyberpunk' | 'metro' | 'jungle' | 'space';
}
const { theme } = Astro.props;
const legends = {
  medieval: 'Turn the page',
  cyberpunk: 'Switch frequency',
  metro: 'Choose a world',
  jungle: 'Part the leaves',
  space: 'Choose your orbit',
};
---

<div class:list={['world-controls', `${theme}-controls`]}>
  <fieldset class="world-picker" aria-label="Choose a visual world">
    <legend>{legends[theme]}</legend>
    <button
      type="button"
      data-theme-choice="medieval"
      aria-pressed={theme === 'medieval'}
    >
      <span aria-hidden="true">✦</span> Medieval
    </button>
    <button
      type="button"
      data-theme-choice="cyberpunk"
      aria-pressed={theme === 'cyberpunk'}
    >
      <span aria-hidden="true">⌁</span> Cyberpunk
    </button>
    <button
      type="button"
      data-theme-choice="metro"
      aria-pressed={theme === 'metro'}
    >
      <span aria-hidden="true">▰</span> Metro
    </button>
    <button
      type="button"
      data-theme-choice="jungle"
      aria-pressed={theme === 'jungle'}
    >
      <span aria-hidden="true">❦</span> Jungle
    </button>
    <button
      type="button"
      data-theme-choice="space"
      aria-pressed={theme === 'space'}
    >
      <span aria-hidden="true">✧</span> Space
    </button>
  </fieldset>
  <button
    type="button"
    class="motion-toggle"
    data-motion-toggle
    aria-label="Motion on — Pause ambient motion"
    aria-pressed="false"
  >
    <span aria-hidden="true">Ⅱ</span>
    <span class="motion-label">Motion on</span>
  </button>
</div>
